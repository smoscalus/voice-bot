# ============ ОБЯЗАТЕЛЬНО ============
# Токен бота: discord.com/developers/applications → твоё приложение → Bot → Reset Token
DISCORD_TOKEN=

# ============ МОЗГИ: local или groq ============
# local — всё на этом компьютере (Ollama + Whisper): бесплатно и без лимитов, но глупее и медленнее.
# groq  — облако Groq: умнее и быстрее, бесплатно, но с дневными лимитами. Нужен ключ ниже.
# Переключать можно и на ходу, командой /brain в Discord.
PROVIDER=local

# Ключ Groq (бесплатно: console.groq.com → API Keys). Нужен только для PROVIDER=groq.
GROQ_API_KEY=

# ============ НЕОБЯЗАТЕЛЬНО (всё ниже можно не трогать) ============

# --- local: модель Ollama. qwen2.5:7b — умнее (лучше с видеокартой), qwen2.5:3b — быстрее на слабом железе
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# Whisper для распознавания речи: tiny / base / small / medium (больше — точнее, но медленнее)
LOCAL_WHISPER_MODEL=small
# auto — видеокарта, если заведётся, иначе процессор
LOCAL_WHISPER_DEVICE=auto

# --- groq: модели (обычно менять не нужно)
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_LIGHT_MODEL=openai/gpt-oss-20b
# GROQ_MEMORY_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# --- голос
# piper — локальный и мгновенный; edge — голоса Microsoft (живее, но медленнее и иногда тупит)
TTS_BACKEND=piper
# ru_RU-dmitri-medium / ru_RU-denis-medium / ru_RU-ruslan-medium / ru_RU-irina-medium (женский)
PIPER_VOICE=ru_RU-dmitri-medium
# темп (1.0 обычный, 1.2 быстрее) и живость интонации (0.3 монотонно … 1.0 эмоционально)
PIPER_SPEED=1.0
PIPER_LIVELINESS=0.667
EDGE_VOICE=ru-RU-DmitryNeural

# --- поведение
# как часто сам влезает в разговор
PROACTIVE_COOLDOWN_S=40
PROACTIVE_MAX_PER_10MIN=8
# сколько мс надо говорить поверх бота, чтобы он замолчал (0 — выключить)
BARGE_IN_MS=900
# пауза (мс), после которой фраза считается законченной
SILENCE_MS=500
