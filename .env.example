# ============ ОБЯЗАТЕЛЬНО ============
# Токен бота: discord.com/developers/applications → твоё приложение → Bot → Reset Token
DISCORD_TOKEN=

# ============ МОЗГИ: local или groq ============
# local — всё на этом компьютере (Ollama + Whisper): бесплатно и без лимитов, но глупее и медленнее.
# groq  — облако Groq: умнее и быстрее, бесплатно, но с дневными лимитами. Нужен ключ ниже.
# Переключать можно и на ходу, командой /brain в Discord.
PROVIDER=local

# Ключ Groq (бесплатно: console.groq.com → API Keys). Нужен для PROVIDER=groq.
# Совет: даже при PROVIDER=local с ключом распознавание речи пойдёт через Groq — быстро и точно,
# а мозги останутся на компе без лимитов.
GROQ_API_KEY=

# ============ ИМЯ ============
# Как зовут бота. Новое имя — новый «человек» с чистой памятью; старый остаётся в своих файлах в data/
# и вернётся, если вернуть имя.
BOT_NAME=Петрык
# Как ещё его зовут и как его коверкает распознавание (через запятую), например: Васёк, Василий
BOT_NAME_ALIASES=

# ============ НЕОБЯЗАТЕЛЬНО (всё ниже можно не трогать) ============

# --- local: модель Ollama (чем больше видеопамяти, тем умнее можно взять)
#   видеокарта 8 ГБ и больше → qwen3.5:9b   (основная, ~6.5 ГБ)
#   видеокарта 12–16+ ГБ     → qwen2.5:14b  (тоже хороша, ~9 ГБ)
#   видеокарта 6 ГБ          → qwen2.5:7b
#   слабое железо / без видеокарты → qwen2.5:3b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434

# --- железо: профиль видеокарты (ставит start.bat / ./start.sh по ответам; можно поменять руками)
#   8gb  — ноутбучные 8 ГБ (RTX 4060/5060…): окно 6144, 1 слот, сжатый кэш, Whisper на процессоре
#   12gb — 10–12 ГБ: окно 8192, 1 слот, сжатый кэш
#   16gb — 16 ГБ и больше (RX 6900 XT, RTX 4080…): окно 8192, 2 слота
#   cpu  — без видеокарты: окно 4096, 1 слот
GPU_PROFILE=12gb
# Окно модели. Это же число должно стоять и у САМОЙ Ollama (start-скрипт настраивает её сам),
# иначе Ollama молча обрежет начало промпта — бот потеряет характер и понесёт бред (бот предупредит в логе).
OLLAMA_CONTEXT_LENGTH=8192
# Настройки самой Ollama (их тоже применяет start-скрипт): слоты, сжатие кэша (q8_0 — вдвое меньше памяти),
# flash attention. На AMD под Windows — OLLAMA_VULKAN=1.
OLLAMA_NUM_PARALLEL=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1

# --- размышления локальной модели (qwen3.5 и другие «думающие»): on / off / auto (как решит модель)
# В живом ответе — off: иначе перед каждой репликой +3–10 с тишины.
THINK_REPLY=off
# В фоне (досье на людей, самоосознание, сны, книжка) — on: никто не ждёт, а пишет аккуратнее.
THINK_BACKGROUND=on
# Распознавание речи: auto — Groq, если есть ключ, иначе на компе; local / groq — выбрать вручную
STT_PROVIDER=auto
# Whisper на компе: auto (small на видеокарте, base на процессоре) / tiny / base / small / medium
LOCAL_WHISPER_MODEL=auto
# auto — видеокарта, если заведётся, иначе процессор
LOCAL_WHISPER_DEVICE=auto

# --- groq: модели (обычно менять не нужно)
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_LIGHT_MODEL=openai/gpt-oss-20b
# GROQ_MEMORY_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# --- голос
# piper — локальный и мгновенный; edge — голоса Microsoft (живее, но медленнее и иногда тупит)
TTS_BACKEND=piper
# ru_RU-dmitri-medium / ru_RU-denis-medium / ru_RU-ruslan-medium / ru_RU-irina-medium (женский)
# (голос скачается сам при первом запуске)
PIPER_VOICE=ru_RU-dmitri-medium
# темп (1.0 обычный, 1.2 быстрее) и живость интонации (0.3 монотонно … 1.0 эмоционально)
PIPER_SPEED=1.0
PIPER_LIVELINESS=0.667
# голоса edge: ru-RU-DmitryNeural (мужской) / ru-RU-SvetlanaNeural (женский)
EDGE_VOICE=ru-RU-DmitryNeural

# --- поведение
# как часто сам влезает в разговор
PROACTIVE_COOLDOWN_S=90
PROACTIVE_MAX_PER_10MIN=5
# «свои дела»: в затишье сам начинает тему — не чаще раза в столько секунд
OWN_INITIATIVE_GAP_S=600
# жизнь: через столько дней после рождения он умирает (0 — бессмертный); память — в data/кладбище/
LIFESPAN_DAYS=14
# раз в столько часов «сон»: что вспоминалось — крепнет, остальное аккуратно тускнеет
FADE_EVERY_HOURS=48
# «книжка»: о чём спросил и не получил ответа — сам читает (Википедия), не чаще столько раз в сутки; 0 — выкл
BOOK_PER_DAY=10
# перебивание голосом: 0 — нельзя перебить, всегда договаривает («танк»);
# 900 — замолкает, если говорить поверх него дольше 0.9 с
BARGE_IN_MS=0
# пауза (мс), после которой фраза считается законченной
SILENCE_MS=500
